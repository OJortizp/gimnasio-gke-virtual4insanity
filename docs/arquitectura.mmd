    classDef internalSvc fill:#0D9488,stroke:#0F766E,stroke-width:2px,color:#FFFFFF
    classDef apiPod fill:#CCFBF1,stroke:#0D9488,stroke-width:2px,color:#134E4A
    classDef dbService fill:#4F46E5,stroke:#4338CA,stroke-width:2px,color:#FFFFFF
    classDef dbPod fill:#E0E7FF,stroke:#4F46E5,stroke-width:2px,color:#1E1B4B
    classDef storage fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#78350F
