    %% =========================================================================
    %% Diagrama de Arquitectura — Sistema de Gestión de Gimnasio en GKE
    %% Equipo: virtual4insanity | Proyecto GCP: gimnasio-virtual4insanity | Criterio A3
    %% =========================================================================

    subgraph EXT["Capa Externa · Cliente"]
        USER["Usuario / Navegador Web<br/>Cliente HTTP Externo"]
    end

    subgraph GCP["Google Cloud Platform · Proyecto: gimnasio-virtual4insanity · Región: us-central1"]

        subgraph AR["Artifact Registry · Repositorio Docker: gimnasio (us-central1)"]
            IMG_FE["Imagen: frontend:v1<br/>us-central1-docker.pkg.dev/gimnasio-virtual4insanity/gimnasio/frontend:v1"]
            IMG_M["Imagen: api-miembros:v1<br/>us-central1-docker.pkg.dev/gimnasio-virtual4insanity/gimnasio/api-miembros:v1"]
            IMG_C["Imagen: api-clases:v1 / v2<br/>us-central1-docker.pkg.dev/gimnasio-virtual4insanity/gimnasio/api-clases:v1"]
            IMG_DB["Imagen: postgres:16-alpine<br/>us-central1-docker.pkg.dev/gimnasio-virtual4insanity/gimnasio/postgres:16-alpine"]
        end

        subgraph GKE["Clúster GKE Standard Zonal: gke-virtual4insanity · Zona: us-central1-a (Node Pool pool-spot: 2 nodos e2-small Spot, 30 GB pd-balanced)"]

            subgraph NS["Namespace: virtual4insanity"]

                subgraph INGRESS["Capa de Exposición Pública y Frontend (k8s/40-frontend.yaml)"]
                    SVC_FE["Service: frontend<br/>Tipo: LoadBalancer · IP Pública Externa<br/>Puerto: 80 → targetPort: 80"]
                    DEP_FE["Deployment / Pod: frontend (app: frontend)<br/>Python 3.12 · Flask · Gunicorn · Bootstrap 5 (templates/index.html)<br/>Reenvío proxy /api/miembros y /api/clases por DNS · Puerto: 80"]
                end

                subgraph APIS["Capa de Microservicios (Python 3.12 · Flask · Gunicorn)"]
                    SVC_M["Service: api-miembros<br/>Tipo: ClusterIP<br/>DNS: api-miembros:5000"]
                    DEP_M["Deployment / Pod: api-miembros (app: api-miembros)<br/>Rutas: /api/miembros y /api/miembros/integrantes<br/>Puerto contenedor: 5000"]

                    SVC_C["Service: api-clases<br/>Tipo: ClusterIP<br/>DNS: api-clases:5000"]
                    DEP_C["Deployment / Pod: api-clases (app: api-clases)<br/>Rutas: /api/clases<br/>Puerto contenedor: 5000"]
                end

                subgraph DATA["Capa de Datos y Almacenamiento Persistente (k8s/10-db.yaml)"]
                    SVC_DB["Service: db<br/>Tipo: ClusterIP<br/>DNS: db:5432"]
                    DEP_DB["Deployment / Pod: db (app: db)<br/>Motor: PostgreSQL 16 · Base: gimnasio<br/>Tablas: integrantes, miembros, clases<br/>PGDATA: /var/lib/postgresql/data/pgdata · Puerto: 5432"]
                    PVC_DB["PersistentVolumeClaim: db-pvc<br/>Capacidad: 1 Gi · ReadWriteOnce<br/>Montaje: /var/lib/postgresql/data"]
                    CM_INIT["ConfigMap: db-init<br/>Script: db/init.sql<br/>Montaje: /docker-entrypoint-initdb.d (readOnly)"]
                end

                subgraph CFG["Configuración y Credenciales"]
                    CM_FE["ConfigMap: frontend-config<br/>MIEMBROS_URL=http://api-miembros:5000<br/>CLASES_URL=http://api-clases:5000"]
                    CM_APP["ConfigMap: gimnasio-config<br/>DB_HOST=db | DB_PORT=5432 | DB_NAME=gimnasio<br/>MIEMBROS_URL=http://api-miembros:5000<br/>EQUIPO=virtual4insanity"]
                    SEC_APP["Secret: gimnasio-secret (Opaque)<br/>DB_USER | DB_PASSWORD"]
                end

            end
        end
    end

    %% --- Flujo principal de tráfico de red ---
    USER -->|"HTTP :80 (IP Pública)"| SVC_FE
    SVC_FE -->|"TCP :80"| DEP_FE
    DEP_FE -->|"HTTP GET/POST/PUT/DELETE<br/>/api/miembros... → http://api-miembros:5000"| SVC_M
    DEP_FE -->|"HTTP GET/POST/PUT/DELETE<br/>/api/clases... → http://api-clases:5000"| SVC_C
    SVC_M -->|"TCP :5000"| DEP_M
    SVC_C -->|"TCP :5000"| DEP_C
    DEP_C -->|"HTTP GET /api/miembros/<id><br/>Validación de miembro (DNS: api-miembros:5000)"| SVC_M

    %% --- Flujo hacia Base de Datos y Persistencia ---
    DEP_M -->|"TCP / PostgreSQL :5432 (DNS: db:5432)<br/>Tablas: miembros, integrantes"| SVC_DB
    DEP_C -->|"TCP / PostgreSQL :5432 (DNS: db:5432)<br/>Tabla: clases"| SVC_DB
    SVC_DB -->|"TCP :5432"| DEP_DB
    DEP_DB -->|"Lectura / Escritura Persistente<br/>/var/lib/postgresql/data"| PVC_DB
    CM_INIT -.->|"Inicialización SQL única<br/>/docker-entrypoint-initdb.d"| DEP_DB

    %% --- Inyección de ConfigMaps y Secret ---
    CM_FE -.->|"envFrom (MIEMBROS_URL, CLASES_URL)"| DEP_FE
    CM_APP -.->|"envFrom (variables no sensibles)"| DEP_M
    CM_APP -.->|"envFrom (variables no sensibles)"| DEP_C
    CM_APP -.->|"valueFrom (POSTGRES_DB)"| DEP_DB
    SEC_APP -.->|"envFrom (DB_USER, DB_PASSWORD)"| DEP_M
    SEC_APP -.->|"envFrom (DB_USER, DB_PASSWORD)"| DEP_C
    SEC_APP -.->|"valueFrom (POSTGRES_USER, POSTGRES_PASSWORD)"| DEP_DB

    %% --- Descarga de imágenes desde Artifact Registry ---
    IMG_FE -.->|"Image Pull"| DEP_FE
    IMG_M -.->|"Image Pull"| DEP_M
    IMG_C -.->|"Image Pull"| DEP_C
    IMG_DB -.->|"Image Pull"| DEP_DB

    %% --- Estilos visuales por capa ---
