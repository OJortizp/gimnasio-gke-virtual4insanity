    class DEP_M,DEP_C apiPod
    class SVC_DB dbService
    class DEP_DB dbPod
    class PVC_DB storage
    class CM_FE,CM_APP,SEC_APP,CM_INIT config
    class IMG_FE,IMG_M,IMG_C,IMG_DB registry
